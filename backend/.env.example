SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# --- LLM provider (environment-driven; swapping provider is config, not code) ---
# Default provider is Gemini Flash. Set LLM_API_KEY to a Google AI Studio key and
# a hard billing cap on Google's side before enabling live calls.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# LLM_BASE_URL=                             # optional endpoint override
# Groq is kept as a fallback adapter (LLM_PROVIDER=groq). If set and LLM_API_KEY
# is empty, GROQ_API_KEY is used as the key for the Groq provider.
GROQ_API_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:...
DATABASE_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=    # optional locally
ENV=development
CORS_ALLOW_ORIGINS=http://localhost:5173
