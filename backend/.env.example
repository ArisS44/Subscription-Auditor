SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# --- LLM provider (environment-driven; swapping provider is config, not code) ---
# Default provider is Gemini Flash. Set LLM_API_KEY to a Google AI Studio key and
# a hard billing cap on Google's side before enabling live calls.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=
# LLM_BASE_URL=                             # optional endpoint override
# App-level daily message cap (abuse tripwire): enforced before any LLM call, so
# it can't be exceeded. At ~$0.0015/message on gemini-flash-lite-latest, 2000/day
# bounds worst-case daily spend to a few dollars — a backstop behind the fixed
# Gemini prepaid-credit ceiling. Raise/lower to taste.
CHAT_GLOBAL_DAILY_CAP=2000
# Groq is kept as a fallback adapter (LLM_PROVIDER=groq). If set and LLM_API_KEY
# is empty, GROQ_API_KEY is used as the key for the Groq provider.
GROQ_API_KEY=
# --- Web Push (VAPID) ---
# One ECDSA P-256 keypair for the whole application, base64url-encoded without
# padding. The private key signs the JWT this backend sends to a browser's push
# service, proving a push to a given subscription came from the same app the
# user granted permission to - so a leaked endpoint URL alone cannot be used to
# push. Generate with backend/.venv/bin/python and `cryptography` (see
# infra/azure/README.md); the private key is a real secret and lives only here
# and in Key Vault. The public key is NOT secret - it is baked into the frontend
# bundle. VAPID_SUBJECT is a mailto:/https: contact URI embedded in the signed
# JWT so a push provider can reach the operator; push services reject requests
# without it.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:...
# Shared secret the external scheduler sends in the X-Job-Token header to
# authenticate a scheduled run. Must match the value in GitHub Actions secrets
# and Key Vault. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JOB_TOKEN=
DATABASE_URL=
APPLICATIONINSIGHTS_CONNECTION_STRING=    # optional locally
ENV=development
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
