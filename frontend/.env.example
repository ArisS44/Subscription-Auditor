VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Web Push application server key, passed to pushManager.subscribe(). This is
# the PUBLIC half of the VAPID keypair only - it is baked into the built bundle
# and readable by anyone, which is by design. The private key must never appear
# in any VITE_* variable or anywhere else the frontend can reach.
VITE_VAPID_PUBLIC_KEY=
# Cloudflare Turnstile site key. Leave empty in dev to use Cloudflare's public
# always-passing test key (1x00000000000000000000AA); set the real key in prod.
VITE_TURNSTILE_SITE_KEY=
